config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MWGodot (eksperyment)"
config/description="Eksperymentalny remaster Morrowinda na Godot 4 – dane z legalnej instalacji gracza."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/mw_cs2/plugin.cfg")

