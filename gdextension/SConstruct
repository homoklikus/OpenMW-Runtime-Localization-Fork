#!/usr/bin/env python
# Budowa: scons -C gdextension platform=linux target=template_debug GODOT_CPP=/ścieżka/godot-cpp
import os
godot_cpp = ARGUMENTS.get("GODOT_CPP", os.environ.get("GODOT_CPP", "godot-cpp"))
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
lib = env.SharedLibrary("../godot/bin/libmw_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(lib)
